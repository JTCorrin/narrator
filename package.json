{
	"name": "obsidian-narrator-plugin",
	"version": "1.1.1",
	"description": "Narrate your notes with AI voice generation",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit && node esbuild.config.mjs production",
		"build:local": "NARRATOR_API_BASE_URL=http://192.168.5.140:8000/api/v1 pnpm run build",
		"build:prod": "NARRATOR_API_BASE_URL=https://narrator.corrin.ai/api/v1 pnpm run build",
		"deploy": "pnpm run build && node scripts/deploy.mjs",
		"deploy:local": "pnpm run build:local && node scripts/deploy.mjs",
		"deploy:prod": "pnpm run build:prod && node scripts/deploy.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint src main.ts package.json --max-warnings 0",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"narration",
		"voice",
		"audio",
		"text-to-speech"
	],
	"author": "Joe",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9",
		"@eslint/json": "0.14.0",
		"@types/node": "^22.15.30",
		"@vitest/coverage-v8": "2",
		"esbuild": "^0.25.5",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"obsidian": "^1.13.1",
		"tslib": "^2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8",
		"vitest": "2"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@9.15.9"
}
